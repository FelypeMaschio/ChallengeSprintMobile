{
  "expo": {
    "name": "Clyvo Vet",
    "slug": "felypemaschio",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C3BFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C3BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "br.com.fiap.clyvovet",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Clyvo Vet usa suas fotos para você escolher a imagem do seu pet.",
          "cameraPermission": "O Clyvo Vet usa a câmera para você fotografar o seu pet."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C3BFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "368a79ca-f84a-4c3a-9e5f-9972f97fcae1"
      }
    },
    "owner": "felypemaschios-team"
  }
}
